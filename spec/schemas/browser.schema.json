{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubunatic.com/headbox/spec/schemas/browser.schema.json",
  "title": "Pinned headless browser and its sandbox limits",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "url_template", "sha256", "tmp_bytes", "shm_bytes", "home_bytes", "serve_idle"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){3}$"},
    "url_template": {"type": "string", "pattern": "^https://.*\\{version\\}.*\\.zip$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tmp_bytes": {"type": "integer", "minimum": 1048576},
    "shm_bytes": {"type": "integer", "minimum": 1048576},
    "home_bytes": {"type": "integer", "minimum": 1048576},
    "serve_idle": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"}
  }
}
